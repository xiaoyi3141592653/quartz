    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 包含参数的当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": ["/Users/lixiaoyi/Documents/obsidian/xiaoyili/deploy"]
        },
        {
            "type": "node",
            "request": "launch",
            "name": "启动程序",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "runtimeExecutable": "npm", // 指定用 npm 执行
            "runtimeArgs": [
                "run",
                "quartz",
                "--",
                "build"
            ], // 对应 package.json 的 script
            "console": "integratedTerminal", // 在终端显示日志
            "outFiles": [
                "${workspaceFolder}/**/*.js"
            ]
        }
    ]
}